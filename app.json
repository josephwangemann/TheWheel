{
  "expo": {
    "name": "The Wheel",
    "slug": "thewheel",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fractalscape13.thewheel",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.fractalscape13.thewheel",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0E18"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#0D0E18",
          "android": {
            "imageWidth": 176
          }
        }
      ],
      "expo-font",
      "expo-build-properties"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "userInterfaceStyle": "dark"
  }
}
